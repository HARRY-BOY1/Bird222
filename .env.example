# انسخ هذا الملف إلى .env (لا ترفعه إلى GitHub) أو ضع القيم في متغيرات البيئة على الاستضافة
# عنوان الباك-إند الحقيقي — يبقى على الخادم فقط ولا يصل للمتصفح
UPSTREAM_URL=https://your-backend.example.com

# اختياري: مسارات أخرى يجب تمريرها للباك-إند (مفصولة بفاصلة)
# PROXY_PREFIXES=/api,/socket.io,/uploads,/files,/avatars,/health
DATA_DIR=./data
