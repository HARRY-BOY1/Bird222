{
  "name": "messenger-server",
  "version": "1.0.0",
  "private": true,
  "description": "Real-time messaging server (Telegram-like) built with Express, Socket.IO and SQLite",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "demo": "node scripts/demo-client.js",
    "tunnel": "node scripts/start-tunnel.js",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "express",
    "socket.io",
    "sqlite",
    "chat",
    "realtime"
